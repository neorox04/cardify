# =============================================================================
# TEMPLATE DE PRODUÇÃO — Cardifys
# -----------------------------------------------------------------------------
# NÃO é um ficheiro ativo. É uma referência: copia estes valores para o painel
# de variáveis de ambiente da tua plataforma (Laravel Cloud / Forge), e
# preenche os campos marcados com <...>. NUNCA metas segredos reais no Git.
# Passo a passo completo em docs/DEPLOY.md.
# =============================================================================

APP_NAME=Cardifys
APP_ENV=production
APP_KEY=                      # gera com: php artisan key:generate --show
APP_DEBUG=false               # OBRIGATÓRIO false em produção
APP_URL=https://cardifys.com  # o teu domínio real, com https

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error               # em produção só erros (não debug)

# --- Base de dados (real — NÃO sqlite). Na Laravel Cloud é injetado pela BD gerida.
DB_CONNECTION=mysql           # ou pgsql
DB_HOST=<host-da-bd>
DB_PORT=3306
DB_DATABASE=<nome-da-bd>
DB_USERNAME=<user>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # cookies só por https

# --- Fila: os emails são enfileirados; é PRECISO um worker a correr (ver docs/DEPLOY.md §5)
QUEUE_CONNECTION=database      # ou redis se disponível
CACHE_STORE=database
FILESYSTEM_DISK=local          # ou s3, se usares storage externo

# --- Email transacional (sair do gmail para entregabilidade; ver docs/DEPLOY.md §5)
MAIL_MAILER=smtp
MAIL_HOST=<host-do-provider>   # ex.: Resend/Postmark
MAIL_PORT=587
MAIL_USERNAME=<user>
MAIL_PASSWORD=<password>
MAIL_FROM_ADDRESS="no-reply@cardifys.com"   # do TEU domínio (para o DKIM assinar)
MAIL_FROM_NAME="Cardifys"
# Caixas onde RECEBES (podem ficar gmail):
MAIL_SUPPORT_ADDRESS="support.cardifys@gmail.com"
MAIL_GENERAL_ADDRESS="geral.cardifys@gmail.com"

# --- Stripe / Cashier (modo LIVE)
STRIPE_KEY=<pk_live_...>
STRIPE_SECRET=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>              # do endpoint do webhook live
STRIPE_PRICE_INDIVIDUAL_MONTHLY=<price_live_...>
STRIPE_PRICE_INDIVIDUAL_YEARLY=<price_live_...>
STRIPE_PRICE_COMPANY=<price_live_...>
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=pt

# --- Sentry (monitorização de erros). Põe o DSN do projeto Laravel em sentry.io.
SENTRY_LARAVEL_DSN=<https://...@....ingest.sentry.io/...>
SENTRY_TRACES_SAMPLE_RATE=0.2

VITE_APP_NAME="${APP_NAME}"
